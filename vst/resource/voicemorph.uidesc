  <!-- Pitch and formant remain separate existing VST3 parameters.
       In these asymmetric semitone ranges, 0 st is at 2/3 and 4/7
       respectively, NOT at physical 50 percent. -->
  <view class="CSlider" origin="18, 471" size="253, 15" control-tag="P117"
        default-value="0.666666667" orientation="horizontal" mode="free click"
        draw-frame="true" draw-back="true" draw-value="true"
        draw-value-from-center="false" frame-width="1"
        draw-frame-color="Outline" draw-back-color="Field" draw-value-color="Accent"/>
  <view class="CSlider" origin="304, 471" size="253, 15" control-tag="P118"
        default-value="0.571428571" orientation="horizontal" mode="free click"
        draw-frame="true" draw-back="true" draw-value="true"
        draw-value-from-center="false" frame-width="1"
        draw-frame-color="Outline" draw-back-color="Field" draw-value-color="Accent"/>
  <!-- Thin ticks below the tracks show 0 semitones, not range midpoints. -->
